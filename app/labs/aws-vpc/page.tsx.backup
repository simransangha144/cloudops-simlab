"use client";

import { useMemo, useState } from "react";

type ComponentId =
  | "internet"
  | "igw"
  | "public-subnet"
  | "nat"
  | "private-subnet"
  | "alb";

type Component = {
  id: ComponentId;
  name: string;
  description: string;
  short: string;
};

const components: Component[] = [
  {
    id: "internet",
    name: "Internet",
    description: "External network",
    short: "INTERNET",
  },
  {
    id: "igw",
    name: "Internet Gateway",
    description: "Provides a path between the VPC and Internet",
    short: "IGW",
  },
  {
    id: "public-subnet",
    name: "Public Subnet",
    description: "Subnet with a route toward the Internet Gateway",
    short: "PUBLIC",
  },
  {
    id: "nat",
    name: "NAT Gateway",
    description: "Allows private resources to make outbound connections",
    short: "NAT",
  },
  {
    id: "private-subnet",
    name: "Private Subnet",
    description: "Subnet without direct inbound Internet exposure",
    short: "PRIVATE",
  },
  {
    id: "alb",
    name: "Application Load Balancer",
    description: "Receives HTTP/HTTPS traffic from clients",
    short: "ALB",
  },
];

const requiredComponents: ComponentId[] = [
  "igw",
  "public-subnet",
  "nat",
  "private-subnet",
];

export default function AwsVpcLab() {
  const [selected, setSelected] = useState<ComponentId[]>([]);
  const [validated, setValidated] = useState(false);

  const isComplete = useMemo(() => {
    return requiredComponents.every((component) =>
      selected.includes(component)
    );
  }, [selected]);

  function toggleComponent(id: ComponentId) {
    setValidated(false);

    setSelected((current) =>
      current.includes(id)
        ? current.filter((item) => item !== id)
        : [...current, id]
    );
  }

  function resetLab() {
    setSelected([]);
    setValidated(false);
  }

  return (
    <main className="min-h-screen bg-[#070b12] text-white">
      {/* Header */}
      <header className="border-b border-white/10">
        <div className="mx-auto flex max-w-7xl items-center justify-between px-6 py-5">
          <div>
            <a
              href="/"
              className="text-sm text-gray-500 transition hover:text-white"
            >
              ← CloudOps SimLab
            </a>

            <h1 className="mt-2 text-xl font-semibold">
              AWS VPC Architecture Lab
            </h1>
          </div>

          <div className="rounded-full border border-blue-400/20 bg-blue-400/5 px-4 py-2 text-xs text-blue-300">
            LAB_01
          </div>
        </div>
      </header>

      {/* Scenario */}
      <section className="border-b border-white/10 bg-[#090e17]">
        <div className="mx-auto max-w-7xl px-6 py-10">
          <div className="max-w-4xl">
            <p className="text-xs font-semibold uppercase tracking-[0.2em] text-blue-400">
              Scenario
            </p>

            <h2 className="mt-3 text-2xl font-bold">
              Build a production-style private application network
            </h2>

            <p className="mt-4 leading-7 text-gray-400">
              Your application servers must run inside a private subnet. They
              need outbound Internet access for software updates, but they
              must not be directly reachable from the public Internet.
            </p>

            <div className="mt-6 grid gap-3 sm:grid-cols-3">
              <Requirement label="Private application tier" />
              <Requirement label="Outbound Internet access" />
              <Requirement label="No direct public exposure" />
            </div>
          </div>
        </div>
      </section>

      {/* Lab */}
      <section>
        <div className="mx-auto grid max-w-7xl gap-8 px-6 py-10 lg:grid-cols-[300px_1fr]">
          {/* Component palette */}
          <aside>
            <div className="mb-4">
              <p className="text-sm font-semibold">Infrastructure</p>
              <p className="mt-1 text-xs text-gray-500">
                Select components to construct the architecture.
              </p>
            </div>

            <div className="space-y-3">
              {components.map((component) => {
                const active = selected.includes(component.id);

                return (
                  <button
                    key={component.id}
                    onClick={() => toggleComponent(component.id)}
                    className={`w-full rounded-xl border p-4 text-left transition ${
                      active
                        ? "border-blue-400/50 bg-blue-500/10"
                        : "border-white/10 bg-white/[0.02] hover:border-white/25"
                    }`}
                  >
                    <div className="flex items-center justify-between">
                      <span className="font-medium">{component.name}</span>

                      <span
                        className={`font-mono text-xs ${
                          active ? "text-blue-400" : "text-gray-600"
                        }`}
                      >
                        {active ? "ON" : component.short}
                      </span>
                    </div>

                    <p className="mt-2 text-xs leading-5 text-gray-500">
                      {component.description}
                    </p>
                  </button>
                );
              })}
            </div>
          </aside>

          {/* Architecture */}
          <div>
            <div className="mb-4 flex items-center justify-between">
              <div>
                <p className="text-sm font-semibold">Architecture Canvas</p>
                <p className="mt-1 text-xs text-gray-500">
                  VPC: 10.0.0.0/16
                </p>
              </div>

              <button
                onClick={resetLab}
                className="rounded-lg border border-white/10 px-4 py-2 text-xs text-gray-400 transition hover:border-white/25 hover:text-white"
              >
                Reset
              </button>
            </div>

            <div className="min-h-[560px] rounded-2xl border border-white/10 bg-[#0b111b] p-6">
              <div className="flex min-h-[500px] flex-col rounded-xl border border-blue-400/20 bg-blue-400/[0.02] p-6">
                <div className="flex items-center justify-between">
                  <div>
                    <span className="font-mono text-xs text-blue-400">
                      AWS_VPC
                    </span>
                    <h3 className="mt-1 font-semibold">10.0.0.0/16</h3>
                  </div>

                  <div className="rounded-md border border-white/10 px-3 py-1 text-xs text-gray-500">
                    us-east-1
                  </div>
                </div>

                <div className="mt-8 flex flex-1 flex-col justify-center gap-6">
                  {/* Internet */}
                  {selected.includes("internet") && (
                    <ArchitectureNode
                      title="Internet"
                      subtitle="External network"
                      type="external"
                    />
                  )}

                  {/* IGW */}
                  {selected.includes("igw") && (
                    <Connection label="Internet Gateway" />
                  )}

                  {/* Public subnet */}
                  {selected.includes("public-subnet") && (
                    <Subnet
                      title="Public Subnet"
                      cidr="10.0.1.0/24"
                      publicSubnet
                    >
                      {selected.includes("alb") && (
                        <ArchitectureNode
                          title="Application Load Balancer"
                          subtitle="HTTP / HTTPS"
                        />
                      )}

                      {selected.includes("nat") && (
                        <ArchitectureNode
                          title="NAT Gateway"
                          subtitle="Outbound Internet"
                        />
                      )}
                    </Subnet>
                  )}

                  {/* Private subnet */}
                  {selected.includes("private-subnet") && (
                    <Subnet
                      title="Private Subnet"
                      cidr="10.0.2.0/24"
                    >
                      <ArchitectureNode
                        title="Application Servers"
                        subtitle="Private EC2 instances"
                      />
                    </Subnet>
                  )}

                  {!selected.length && (
                    <div className="flex flex-1 items-center justify-center text-center">
                      <div>
                        <div className="text-4xl text-gray-700">＋</div>
                        <p className="mt-4 text-sm text-gray-500">
                          Select infrastructure components to begin.
                        </p>
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </div>

            {/* Validation */}
            <div className="mt-6 rounded-2xl border border-white/10 bg-[#0b111b] p-6">
              <div className="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
                <div>
                  <p className="font-semibold">Architecture Validation</p>

                  <p className="mt-1 text-sm text-gray-500">
                    Check whether your architecture satisfies the scenario.
                  </p>
                </div>

                <button
                  onClick={() => setValidated(true)}
                  className="rounded-xl bg-blue-500 px-6 py-3 text-sm font-semibold transition hover:bg-blue-400"
                >
                  Validate Architecture
                </button>
              </div>

              {validated && (
                <ValidationResult
                  success={isComplete}
                  selected={selected}
                />
              )}
            </div>
          </div>
        </div>
      </section>
    </main>
  );
}

function Requirement({ label }: { label: string }) {
  return (
    <div className="rounded-lg border border-white/10 bg-white/[0.02] px-4 py-3 text-sm text-gray-400">
      <span className="mr-2 text-blue-400">✓</span>
      {label}
    </div>
  );
}

function Connection({ label }: { label: string }) {
  return (
    <div className="flex items-center gap-3 py-1">
      <div className="h-px flex-1 bg-blue-400/20" />
      <span className="font-mono text-[10px] uppercase tracking-wider text-blue-400">
        {label}
      </span>
      <div className="h-px flex-1 bg-blue-400/20" />
    </div>
  );
}

function Subnet({
  title,
  cidr,
  children,
  publicSubnet = false,
}: {
  title: string;
  cidr: string;
  children: React.ReactNode;
  publicSubnet?: boolean;
}) {
  return (
    <div
      className={`rounded-xl border p-5 ${
        publicSubnet
          ? "border-green-400/20 bg-green-400/[0.02]"
          : "border-purple-400/20 bg-purple-400/[0.02]"
      }`}
    >
      <div className="mb-4 flex items-center justify-between">
        <div>
          <p className="text-sm font-semibold">{title}</p>
          <p className="mt-1 font-mono text-xs text-gray-500">{cidr}</p>
        </div>

        <span
          className={`rounded-md px-2 py-1 text-[10px] ${
            publicSubnet
              ? "bg-green-400/10 text-green-400"
              : "bg-purple-400/10 text-purple-400"
          }`}
        >
          {publicSubnet ? "PUBLIC" : "PRIVATE"}
        </span>
      </div>

      <div className="grid gap-3 sm:grid-cols-2">{children}</div>
    </div>
  );
}

function ArchitectureNode({
  title,
  subtitle,
  type = "internal",
}: {
  title: string;
  subtitle: string;
  type?: "internal" | "external";
}) {
  return (
    <div
      className={`rounded-lg border p-4 ${
        type === "external"
          ? "mx-auto w-full max-w-sm border-orange-400/20 bg-orange-400/[0.03]"
          : "border-white/10 bg-white/[0.03]"
      }`}
    >
      <div className="text-sm font-medium">{title}</div>
      <div className="mt-1 text-xs text-gray-500">{subtitle}</div>
    </div>
  );
}

function ValidationResult({
  success,
  selected,
}: {
  success: boolean;
  selected: ComponentId[];
}) {
  const missing = requiredComponents.filter(
    (component) => !selected.includes(component)
  );

  if (success) {
    return (
      <div className="mt-6 rounded-xl border border-green-400/20 bg-green-400/5 p-5">
        <div className="font-semibold text-green-400">
          ✓ Architecture validated
        </div>

        <p className="mt-2 text-sm leading-6 text-gray-400">
          Correct. The private subnet can use the NAT Gateway in the public
          subnet for outbound Internet access without assigning public
          addresses directly to the application servers.
        </p>

        <div className="mt-4 font-mono text-xs text-green-400/80">
          VPC → Public Subnet → NAT Gateway → Internet Gateway → Internet
        </div>
      </div>
    );
  }

  return (
    <div className="mt-6 rounded-xl border border-yellow-400/20 bg-yellow-400/5 p-5">
      <div className="font-semibold text-yellow-400">
        ⚠ Architecture incomplete
      </div>

      <p className="mt-2 text-sm leading-6 text-gray-400">
        Your application tier needs a private subnet with a route through a
        NAT Gateway. The NAT Gateway itself requires a path through the
        Internet Gateway.
      </p>

      {missing.length > 0 && (
        <div className="mt-4">
          <p className="text-xs uppercase tracking-wider text-gray-500">
            Missing components
          </p>

          <div className="mt-2 flex flex-wrap gap-2">
            {missing.map((id) => {
              const component = components.find((item) => item.id === id);

              return (
                <span
                  key={id}
                  className="rounded-md border border-yellow-400/20 px-2 py-1 text-xs text-yellow-400"
                >
                  {component?.name}
                </span>
              );
            })}
          </div>
        </div>
      )}
    </div>
  );
}
