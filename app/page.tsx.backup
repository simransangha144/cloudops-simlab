function Metric({ value, label }: { value: string; label: string }) {
  return (
    <div>
      <div className="font-mono text-xl font-semibold text-gray-200">
        {value}
      </div>
      <div className="mt-1 text-[9px] uppercase tracking-wider text-gray-600">
        {label}
      </div>
    </div>
  );
}

function PreviewBox({ label, value }: { label: string; value: string }) {
  return (
    <div className="rounded-lg border border-white/10 bg-white/[0.02] p-3">
      <div className="font-mono text-lg text-gray-200">{value}</div>
      <div className="mt-1 text-[8px] tracking-wider text-gray-600">
        {label}
      </div>
    </div>
  );
}

function Badge({ children }: { children: React.ReactNode }) {
  return (
    <span className="rounded-md border border-white/10 bg-white/[0.02] px-2.5 py-1 text-[8px] font-medium uppercase tracking-wider text-gray-500">
      {children}
    </span>
  );
}

function SectionHeading({
  eyebrow,
  title,
  description,
}: {
  eyebrow: string;
  title: string;
  description: string;
}) {
  return (
    <div className="mb-12 max-w-3xl">
      <p className="text-[10px] font-semibold uppercase tracking-[0.22em] text-blue-400">
        {eyebrow}
      </p>

      <h2 className="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
        {title}
      </h2>

      <p className="mt-4 text-sm leading-7 text-gray-500">{description}</p>
    </div>
  );
}
